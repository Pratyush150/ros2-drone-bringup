<?xml version="1.0"?>
<model>
  <name>landing_pad</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Pratyush Vatsa</name>
  </author>
  <description>
    A 4 m circular landing pad with a high-contrast H marking and four corner
    fiducial squares. Text-only SDF -- the marking is built from flat boxes with
    emissive materials rather than a texture, so there are no binary assets to
    carry around and the contrast does not depend on lighting.
  </description>
</model>
